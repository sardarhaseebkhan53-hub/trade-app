# Development-only market data configuration.
# Do not commit a real key. Do not ship a provider key in a production APK.
# Inject values locally with --dart-define or use an AURUM backend proxy in production.

AURUM_MARKET_DATA_MODE=remote
AURUM_MARKET_PROVIDER=coingecko
AURUM_MARKET_API_BASE_URL=https://api.coingecko.com/api/v3
AURUM_MARKET_API_KEY=
AURUM_ENABLE_NETWORK_LOGGING=false
