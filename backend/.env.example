# Runtime
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL — never commit a real connection string
DATABASE_URL=postgresql://aurum:change-me@localhost:5432/aurum?schema=public

# Opaque session policy
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# CORS: comma-separated trusted development origins only
CORS_ORIGINS=http://localhost:3000

# Optional service configuration. Keep provider/private secrets on the backend.
MARKET_PROVIDER_BASE_URL=https://api.coingecko.com/api/v3
MARKET_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
FCM_SERVICE_ACCOUNT_JSON=
